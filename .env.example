# Formularz kontaktowy — wysyłka przez Resend (https://resend.com)
# Skopiuj ten plik do .env.local i uzupełnij klucz.

# Klucz API: https://resend.com/api-keys
RESEND_API_KEY=

# Odbiorca zgłoszeń (opcjonalne — domyślnie kontakt@avenise-flow.pl)
# CONTACT_TO=kontakt@avenise-flow.pl

# Nadawca. Aby wysyłać z własnej domeny (np. formularz@avenise-flow.pl),
# najpierw zweryfikuj avenise-flow.pl w Resend (Domains -> Add Domain -> rekordy DNS).
# Do czasu weryfikacji zostaje adres testowy Resend:
# CONTACT_FROM=AveniseFlow <onboarding@resend.dev>
